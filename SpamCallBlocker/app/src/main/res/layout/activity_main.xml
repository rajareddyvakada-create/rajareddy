<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_block"
            android:background="@drawable/icon_bg"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Spam Call Blocker"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/fg"
            android:fontFamily="@font/space_grotesk"
            android:letterSpacing="-0.02"
            android:paddingStart="12dp" />

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active"
            android:textSize="12sp"
            android:textColor="@color/fg_dim"
            android:paddingStart="6dp" />
    </LinearLayout>

    <!-- Tab Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tab_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:fontFamily="@font/space_grotesk"
                android:padding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tab_selected" />

            <TextView
                android:id="@+id/tab_blocklist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blocklist"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/fg_dim"
                android:fontFamily="@font/space_grotesk"
                android:padding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/tab_unselected" />

            <TextView
                android:id="@+id/tab_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call Log"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/fg_dim"
                android:fontFamily="@font/space_grotesk"
                android:padding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/tab_unselected" />

            <TextView
                android:id="@+id/tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/fg_dim"
                android:fontFamily="@font/space_grotesk"
                android:padding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/tab_unselected" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Dashboard Section -->
            <LinearLayout
                android:id="@+id/section_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Stats Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:padding="14dp"
                        android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Today" android:textSize="11sp" android:textColor="@color/fg_dim"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/stat_today"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="28sp" android:textStyle="bold"
                            android:textColor="@color/accent" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:padding="14dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total Blocked" android:textSize="11sp" android:textColor="@color/fg_dim"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/stat_total"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="28sp" android:textStyle="bold"
                            android:textColor="@color/fg" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:padding="14dp"
                        android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="In Blocklist" android:textSize="11sp" android:textColor="@color/fg_dim"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/stat_blocklist"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="28sp" android:textStyle="bold"
                            android:textColor="@color/fg" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Blocked Calls"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/fg"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recent_blocked_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:background="@drawable/card_bg"
                    android:layoutAnimation="@anim/layout_animation_stagger" />
            </LinearLayout>

            <!-- Blocklist Section -->
            <LinearLayout
                android:id="@+id/section_blocklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Blocked Numbers"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/fg" />
                    <Button
                        android:id="@+id/btn_add_number"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="+ Add Number"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/accent"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/blocklist_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layoutAnimation="@anim/layout_animation_stagger" />
            </LinearLayout>

            <!-- Log Section -->
            <LinearLayout
                android:id="@+id/section_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Blocked Call Log"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/fg" />
                    <Button
                        android:id="@+id/btn_clear_log"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Clear Log"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/fg_dim"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/log_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layoutAnimation="@anim/layout_animation_stagger" />
            </LinearLayout>

            <!-- Settings Section -->
            <LinearLayout
                android:id="@+id/section_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/card_bg"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blocking Rules"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/fg"
                    android:layout_marginBottom="16dp" />

                <include layout="@layout/setting_toggle"
                    android:id="@+id/row_blocking" />

            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
