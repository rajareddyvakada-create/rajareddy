//@version=5
// ════════════════════════════════════════════════════════════════════════════
//  OX ALPHA UT PRO — UT Bot + SMC Order Blocks + Premium / Discount
//  How it works, in order:
//   1. Swings are found with "Swing Length" (24). A close beyond the last
//      swing high / low is a BOS (same trend) or CHoCH (trend change).
//   2. On every break, the order block is the candle that started the move
//      (lowest candle for a bullish break, highest for a bearish break).
//      It stays on the chart until price closes through it (mitigated).
//   3. Premium / Discount is drawn like LuxAlgo SMC: top 5% = Premium,
//      middle band = Equilibrium, bottom 5% = Discount of the current range.
//   4. A BUY prints only when price taps a bullish order block while the
//      UT Bot is bullish and every filter you switched ON agrees
//      (default: price in Discount, structure bullish, CVD bullish).
//      SELL is the mirror (bearish order block, Premium, bearish).
//   5. On each signal a trade map is drawn: Entry, SL (beyond the order
//      block), TP1/TP2/TP3 at the next key levels.
// ════════════════════════════════════════════════════════════════════════════
indicator("Ox Alpha UT Pro — UT Bot + SMC Order Blocks + Key Levels", shorttitle="Ox Alpha UT Pro", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=1000)

// ══════════════════ INPUTS ══════════════════
G_SIG = "① Signals"
G_UT  = "② UT Bot Engine"
G_SMC = "③ Smart Money Concepts (Order Blocks / Premium-Discount)"
G_FLT = "④ Signal Filters (each one ON / OFF)"
G_VP  = "⑤ Volume Profile (daily session)"
G_LVL = "⑥ Key Levels"
G_TP  = "⑦ Trade Map (Entry / SL / TP)"
G_VIS = "⑧ Display"

sigMode    = input.string("Order Block tap", "Signal mode", options=["Order Block tap", "UT flip"], group=G_SIG, tooltip="Order Block tap = signals ONLY when price taps an order block in the UT direction. UT flip = the older mode, a signal after each UT flip.")
showSig    = input.bool(true, "Show BUY / SELL labels", group=G_SIG)

utTf       = input.timeframe("30", "UT Timeframe", group=G_UT, tooltip="Timeframe the UT Bot runs on. Higher-timeframe values are read from the last CLOSED bar, so they do not repaint. If this is equal to or lower than the chart, UT runs on the chart itself.")
utKey      = input.float(1.0, "Key Value (sensitivity)", minval=0.1, step=0.1, group=G_UT, tooltip="Lower = more flips, higher = fewer.")
utAtr      = input.int(10, "ATR Period", minval=1, group=G_UT)
utHA       = input.bool(false, "Use Heikin Ashi close", group=G_UT)
utLive     = input.bool(false, "Use LIVE higher-TF direction (repaints)", group=G_UT, tooltip="ON = earlier signals from the still-forming UT bar, but they can disappear. OFF = confirmed only.")
showUtStop = input.bool(false, "Show UT trailing stop line", group=G_UT)

swingLen   = input.int(24, "Swing Length", minval=5, group=G_SMC, tooltip="Bars on each side needed to confirm a swing high / low. Used for BOS / CHoCH, order blocks and the Premium / Discount range.")
showOB     = input.bool(true, "Show order blocks", group=G_SMC)
obCount    = input.int(3, "Order blocks kept (each side)", minval=1, maxval=10, group=G_SMC)
obMitig    = input.string("Close", "Order block removed when", options=["Close", "Wick"], group=G_SMC, tooltip="Close = removed when a candle CLOSES through it. Wick = removed when a wick goes through it (stricter, like LuxAlgo default).")
showPDz    = input.bool(true, "Show Premium / Equilibrium / Discount zones", group=G_SMC)
showBos    = input.bool(false, "Show BOS / CHoCH lines", group=G_SMC)

usePD      = input.bool(true, "Premium / Discount filter", group=G_FLT, tooltip="Buy only below Equilibrium (Discount half), sell only above it (Premium half).")
useStruct  = input.bool(true, "Structure filter", group=G_FLT, tooltip="Buy only when the last break was bullish (BOS / CHoCH up), sell only when it was bearish.")
useCvd     = input.bool(true, "CVD filter", inline="cvd", group=G_FLT)
cvdLen     = input.int(21, "Smoothing", minval=2, inline="cvd", group=G_FLT, tooltip="Buy only when Cumulative Volume Delta is above its EMA (buyers in control), sell only when below.")
cvdIntra   = input.bool(true, "CVD from intrabar volume", inline="cvd2", group=G_FLT, tooltip="ON = delta built from lower-timeframe candles (more accurate). OFF or not available = estimated from where each candle closed inside its range.")
cvdLtf     = input.timeframe("1", "Intrabar TF", inline="cvd2", group=G_FLT)
usePocF    = input.bool(false, "POC side filter", group=G_FLT, tooltip="Buy only above the session POC, sell only below it.")
useUt2     = input.bool(false, "Slow UT trend filter", inline="ut2", group=G_FLT)
ut2Key     = input.float(3.0, "Key", minval=0.1, step=0.1, inline="ut2", group=G_FLT)
ut2Atr     = input.int(30, "ATR", minval=1, inline="ut2", group=G_FLT)
waitBars   = input.int(20, "UT flip mode: wait for filters (bars)", minval=0, group=G_FLT, tooltip="Only used in UT flip mode. After a flip, the signal prints on the first bar where all ON filters agree, within this many bars.")
showBlock  = input.bool(false, "UT flip mode: mark filtered-out flips (grey ×)", group=G_FLT)

showPoc    = input.bool(false, "Show POC line", inline="vp", group=G_VP)
showVA     = input.bool(false, "Show VAH / VAL lines", inline="vp", group=G_VP)
vpBinMult  = input.float(0.5, "Price bucket size (× ATR)", minval=0.05, step=0.05, group=G_VP)
vpPct      = input.int(70, "Value area %", minval=10, maxval=95, group=G_VP)

showPDHL   = input.bool(true, "PDH / PDL — previous day high / low", group=G_LVL)
showPWHL   = input.bool(true, "PWH / PWL — previous week high / low", group=G_LVL)
showPSHL   = input.bool(true, "PSH / PSL — previous session high / low", group=G_LVL)
psSess     = input.session("0915-1530", "Session", inline="ps", group=G_LVL)
psTz       = input.string("Asia/Kolkata", "Timezone", inline="ps", group=G_LVL, tooltip="Session used for PSH / PSL. Examples: NSE 0915-1530 Asia/Kolkata, New York 0930-1600 America/New_York, London 0800-1630 Europe/London.")
showLvlTag = input.bool(true, "Show level price tags", group=G_LVL)

showTP     = input.bool(true, "Show trade map on signals", group=G_TP)
slMode     = input.string("Order Block", "Stop loss at", options=["Order Block", "UT Stop", "ATR"], group=G_TP, tooltip="Order Block = just beyond the tapped order block (UT flip mode falls back to UT Stop).")
slAtrMult  = input.float(1.5, "ATR multiple (ATR stop)", minval=0.1, step=0.1, group=G_TP)
tpLevels   = input.bool(true, "Targets at next key levels", group=G_TP, tooltip="ON = TP1/2/3 at the next key levels in the trade direction (PDH/PDL, PWH/PWL, PSH/PSL, POC/VAH/VAL, Equilibrium, range high/low). Missing ones fall back to R-multiples. OFF = 1R / 2R / 3R.")
tpBars     = input.int(20, "Trade map length (bars)", minval=5, group=G_TP)

showDash   = input.bool(true, "Show dashboard", group=G_VIS)
dashPosIn  = input.string("Top Right", "Dashboard position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_VIS)

obMode = sigMode == "Order Block tap"
atrC   = ta.atr(14)

// LuxAlgo-style colours
C_BULL_OB = #3179f5
C_BEAR_OB = #f77c80
C_PREM    = #F23645
C_EQ      = #878b94
C_DISC    = #089981

// ══════════════════ 1. UT BOT ENGINE ══════════════════
f_ut(_src, _kv, _ap) =>
    _nLoss = _kv * ta.atr(_ap)
    var float _stop = na
    _prev = nz(_stop[1])
    _stop := _src > _prev and _src[1] > _prev ? math.max(_prev, _src - _nLoss) : _src < _prev and _src[1] < _prev ? math.min(_prev, _src + _nLoss) : _src > _prev ? _src - _nLoss : _src + _nLoss
    var int _pos = 0
    _pos := _src[1] < _prev and _src > _prev ? 1 : _src[1] > _prev and _src < _prev ? -1 : nz(_pos[1])
    [_stop, _pos]

// Previous (closed) bar values, used for non-repainting higher-TF requests
f_utPrev(_src, _kv, _ap) =>
    [_s, _p] = f_ut(_src, _kv, _ap)
    [_s[1], _p[1]]

utSrc  = utHA ? ohlc4 : close
useHtf = timeframe.in_seconds(utTf) > timeframe.in_seconds(timeframe.period)

[cStop, cPos]   = f_ut(utSrc, utKey, utAtr)
[hStop, hPos]   = request.security(syminfo.tickerid, utTf, f_utPrev(utSrc, utKey, utAtr), lookahead=barmerge.lookahead_on)
[lStop, lPos]   = request.security(syminfo.tickerid, utTf, f_ut(utSrc, utKey, utAtr), lookahead=barmerge.lookahead_off)
[c2Stop, c2Pos] = f_ut(utSrc, ut2Key, ut2Atr)
[h2Stop, h2Pos] = request.security(syminfo.tickerid, utTf, f_utPrev(utSrc, ut2Key, ut2Atr), lookahead=barmerge.lookahead_on)

utStop = not useHtf ? cStop : utLive ? lStop : hStop
utDir  = not useHtf ? cPos  : utLive ? lPos  : hPos
ut2Dir = useHtf ? h2Pos : c2Pos

utFlipUp = utDir == 1  and nz(utDir[1]) != 1
utFlipDn = utDir == -1 and nz(utDir[1]) != -1

// ══════════════════ 2. SMC: SWINGS, BOS / CHoCH, ORDER BLOCKS ══════════════════
// Very large candles (≥ 2 × ATR200) have high / low swapped, as in LuxAlgo,
// so a single spike candle is not picked as the order block.
atr200 = ta.atr(200)
hiVol  = not na(atr200) and (high - low) >= 2 * atr200
pHigh  = hiVol ? low : high
pLow   = hiVol ? high : low

// Swing detection (LuxAlgo "leg" method)
var int leg = 0
legHiRef = ta.highest(high, swingLen)
legLoRef = ta.lowest(low, swingLen)
if high[swingLen] > legHiRef
    leg := 0
else if low[swingLen] < legLoRef
    leg := 1
legChg       = leg - nz(leg[1])
newSwingLow  = legChg == 1
newSwingHigh = legChg == -1

var float shLevel   = na
var int   shBar     = na
var bool  shCrossed = true
var float slLevel   = na
var int   slBar     = na
var bool  slCrossed = true
var float trailTop    = na
var int   trailTopBar = na
var float trailBot    = na
var int   trailBotBar = na

if newSwingHigh
    shLevel     := high[swingLen]
    shBar       := bar_index - swingLen
    shCrossed   := false
    trailTop    := high[swingLen]
    trailTopBar := bar_index - swingLen
if newSwingLow
    slLevel     := low[swingLen]
    slBar       := bar_index - swingLen
    slCrossed   := false
    trailBot    := low[swingLen]
    trailBotBar := bar_index - swingLen
if na(trailTop) or high > trailTop
    trailTop    := high
    trailTopBar := bar_index
if na(trailBot) or low < trailBot
    trailBot    := low
    trailBotBar := bar_index

equil    = (trailTop + trailBot) / 2
premLine = 0.95 * trailTop + 0.05 * trailBot
discLine = 0.95 * trailBot + 0.05 * trailTop

// Order block storage (newest first)
var array<float> bullTop  = array.new_float()
var array<float> bullBot  = array.new_float()
var array<bool>  bullUsed = array.new_bool()
var array<box>   bullBox  = array.new_box()
var array<float> bearTop  = array.new_float()
var array<float> bearBot  = array.new_float()
var array<bool>  bearUsed = array.new_bool()
var array<box>   bearBox  = array.new_box()

f_addOB(_tops, _bots, _used, _boxes, _a, _b, _bar, _bull) =>
    _t = math.max(_a, _b)
    _btm = math.min(_a, _b)
    _col = _bull ? C_BULL_OB : C_BEAR_OB
    array.unshift(_tops, _t)
    array.unshift(_bots, _btm)
    array.unshift(_used, false)
    array.unshift(_boxes, showOB ? box.new(_bar, _t, bar_index, _btm, border_color=color.new(_col, 40), bgcolor=color.new(_col, 80), extend=extend.right) : na)
    while array.size(_tops) > obCount
        array.pop(_tops)
        array.pop(_bots)
        array.pop(_used)
        box.delete(array.pop(_boxes))

// Index of the newest unused order block this candle taps, or -1
f_tap(_tops, _bots, _used, _bull) =>
    int _idx = -1
    _n = array.size(_tops)
    if _n > 0
        for _i = 0 to _n - 1
            if _idx == -1 and not array.get(_used, _i)
                _t = array.get(_tops, _i)
                _b = array.get(_bots, _i)
                _hit = _bull ? (low <= _t and close >= _b) : (high >= _b and close <= _t)
                if _hit
                    _idx := _i
    _idx

f_markUsed(_tops, _bots, _used, _t, _b) =>
    _n = array.size(_tops)
    if _n > 0
        for _i = 0 to _n - 1
            if array.get(_tops, _i) == _t and array.get(_bots, _i) == _b
                array.set(_used, _i, true)

f_mitigate(_tops, _bots, _used, _boxes, _bull) =>
    _n = array.size(_tops)
    if _n > 0
        for _i = _n - 1 to 0
            _t = array.get(_tops, _i)
            _b = array.get(_bots, _i)
            _gone = _bull ? (obMitig == "Close" ? close < _b : low < _b) : (obMitig == "Close" ? close > _t : high > _t)
            if _gone
                array.remove(_tops, _i)
                array.remove(_bots, _i)
                array.remove(_used, _i)
                box.delete(array.remove(_boxes, _i))

// a) taps on existing order blocks (checked before this bar can remove them)
bullTapIdx = f_tap(bullTop, bullBot, bullUsed, true)
bearTapIdx = f_tap(bearTop, bearBot, bearUsed, false)
// remember the tapped block by price: later steps on this bar can shift array positions
float bullTapTop = na
float bullTapBot = na
float bearTapTop = na
float bearTapBot = na
if bullTapIdx >= 0
    bullTapTop := array.get(bullTop, bullTapIdx)
    bullTapBot := array.get(bullBot, bullTapIdx)
if bearTapIdx >= 0
    bearTapTop := array.get(bearTop, bearTapIdx)
    bearTapBot := array.get(bearBot, bearTapIdx)

// b) mitigation
f_mitigate(bullTop, bullBot, bullUsed, bullBox, true)
f_mitigate(bearTop, bearBot, bearUsed, bearBox, false)

// c) structure breaks create new order blocks
var int structDir = 0
bullBreak = not shCrossed and not na(shLevel) and close > shLevel
bearBreak = not slCrossed and not na(slLevel) and close < slLevel

if bullBreak
    shCrossed := true
    if showBos
        _choch = structDir == -1
        line.new(shBar, shLevel, bar_index, shLevel, color=C_DISC, style=_choch ? line.style_dashed : line.style_solid)
        label.new(math.round((shBar + bar_index) / 2), shLevel, _choch ? "CHoCH" : "BOS", style=label.style_label_down, color=color.new(color.black, 100), textcolor=C_DISC, size=size.tiny)
    structDir := 1
    // order block = candle with the lowest low between the swing high and now
    obN = math.min(bar_index - shBar, 999)
    float obBest = na
    int obOff = na
    if obN >= 1
        for i = 1 to obN
            if na(obBest) or pLow[i] < obBest
                obBest := pLow[i]
                obOff  := i
    if not na(obOff)
        f_addOB(bullTop, bullBot, bullUsed, bullBox, pHigh[obOff], pLow[obOff], bar_index - obOff, true)

if bearBreak
    slCrossed := true
    if showBos
        _choch = structDir == 1
        line.new(slBar, slLevel, bar_index, slLevel, color=C_PREM, style=_choch ? line.style_dashed : line.style_solid)
        label.new(math.round((slBar + bar_index) / 2), slLevel, _choch ? "CHoCH" : "BOS", style=label.style_label_up, color=color.new(color.black, 100), textcolor=C_PREM, size=size.tiny)
    structDir := -1
    // order block = candle with the highest high between the swing low and now
    obN = math.min(bar_index - slBar, 999)
    float obBest = na
    int obOff = na
    if obN >= 1
        for i = 1 to obN
            if na(obBest) or pHigh[i] > obBest
                obBest := pHigh[i]
                obOff  := i
    if not na(obOff)
        f_addOB(bearTop, bearBot, bearUsed, bearBox, pHigh[obOff], pLow[obOff], bar_index - obOff, false)

// ══════════════════ 3. CVD (Cumulative Volume Delta) ══════════════════
ltfReq = timeframe.in_seconds(cvdLtf) < timeframe.in_seconds(timeframe.period) ? cvdLtf : timeframe.period
[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfReq, [open, close, volume])
float intraDelta = 0.0
nIntra = array.size(ltfV)
if nIntra > 0
    for i = 0 to nIntra - 1
        _o = array.get(ltfO, i)
        _c = array.get(ltfC, i)
        _v = nz(array.get(ltfV, i))
        intraDelta += _c > _o ? _v : _c < _o ? -_v : 0.0
barRange = high - low
estDelta = barRange > 0 ? nz(volume) * ((close - low) - (high - close)) / barRange : 0.0
barDelta = cvdIntra and nIntra > 0 ? intraDelta : estDelta
var float cvd = 0.0
cvd += barDelta
cvdEma  = ta.ema(cvd, cvdLen)
cvdBull = cvd > cvdEma
cvdBear = cvd < cvdEma

// ══════════════════ 4. SESSION VOLUME PROFILE (POC / VAH / VAL) ══════════════════
// Buckets are anchored at the day's open with a fixed size for the whole day.
newDay = timeframe.change("D")
var map<int, float> vpVol = map.new<int, float>()
var float vpAnchor = na
var float vpBin    = na
var int   vpMinK   = na
var int   vpMaxK   = na
var int   vpPocK   = na
var float vpTot    = 0.0
if newDay or na(vpAnchor)
    map.clear(vpVol)
    vpAnchor := open
    vpBin    := math.max(nz(atrC, high - low) * vpBinMult, syminfo.mintick)
    vpMinK   := na
    vpMaxK   := na
    vpPocK   := na
    vpTot    := 0.0

f_vol(_k) =>
    map.contains(vpVol, _k) ? map.get(vpVol, _k) : 0.0

vpK    = math.floor((close - vpAnchor) / vpBin)
vpKVol = f_vol(vpK) + nz(volume)
map.put(vpVol, vpK, vpKVol)
vpTot  += nz(volume)
vpMinK := na(vpMinK) ? vpK : math.min(vpMinK, vpK)
vpMaxK := na(vpMaxK) ? vpK : math.max(vpMaxK, vpK)
float pocVol = -1.0
if not na(vpPocK)
    pocVol := f_vol(vpPocK)
if vpKVol > pocVol
    vpPocK := vpK

loK = vpPocK
hiK = vpPocK
vaAcc = f_vol(vpPocK)
while vaAcc < vpTot * vpPct / 100 and (loK > vpMinK or hiK < vpMaxK)
    loV = loK > vpMinK ? f_vol(loK - 1) : -1.0
    hiV = hiK < vpMaxK ? f_vol(hiK + 1) : -1.0
    if hiV >= loV
        hiK += 1
        vaAcc += hiV
    else
        loK -= 1
        vaAcc += loV

poc = vpAnchor + (vpPocK + 0.5) * vpBin
vah = vpAnchor + (hiK + 1) * vpBin
val = vpAnchor + loK * vpBin

// ══════════════════ 5. KEY LEVELS ══════════════════
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)

inPs    = not na(time(timeframe.period, psSess, psTz))
psStart = inPs and not inPs[1]
var float curSH = na
var float curSL = na
var float psh   = na
var float psl   = na
if psStart
    psh   := curSH
    psl   := curSL
    curSH := high
    curSL := low
else if inPs
    curSH := math.max(nz(curSH, high), high)
    curSL := math.min(nz(curSL, low), low)

// ══════════════════ 6. FILTERS + SIGNALS ══════════════════
okPdB     = not usePD or na(equil) or close < equil
okPdS     = not usePD or na(equil) or close > equil
okStructB = not useStruct or structDir == 1
okStructS = not useStruct or structDir == -1
okCvdB    = not useCvd or cvdBull
okCvdS    = not useCvd or cvdBear
okPocB    = not usePocF or na(poc) or close > poc
okPocS    = not usePocF or na(poc) or close < poc
okUt2B    = not useUt2 or nz(ut2Dir) == 1
okUt2S    = not useUt2 or nz(ut2Dir) == -1
passBuy   = okPdB and okStructB and okCvdB and okPocB and okUt2B
passSell  = okPdS and okStructS and okCvdS and okPocS and okUt2S

// --- Order Block tap mode: one signal per order block ---
obBuy  = obMode and not na(bullTapBot) and utDir == 1 and passBuy
obSell = obMode and not na(bearTapTop) and utDir == -1 and passSell
if obBuy
    f_markUsed(bullTop, bullBot, bullUsed, bullTapTop, bullTapBot)
if obSell
    f_markUsed(bearTop, bearBot, bearUsed, bearTapTop, bearTapBot)

// --- UT flip mode: wait after each flip until the filters agree ---
var int  legDir  = 0
var int  legBar  = na
var bool legDone = true
legOver = not obMode and not legDone and (utFlipUp or utFlipDn or bar_index - legBar > waitBars)
if legOver and showBlock
    label.new(legBar, close, "×", yloc=legDir == 1 ? yloc.belowbar : yloc.abovebar, style=label.style_none, textcolor=color.gray, size=size.normal, tooltip="UT flip filtered out — the ON filters did not agree in time")
if legOver
    legDone := true
if not obMode and (utFlipUp or utFlipDn)
    legDir  := utFlipUp ? 1 : -1
    legBar  := bar_index
    legDone := false
inLeg   = not obMode and not legDone and bar_index - legBar <= waitBars
flipBuy  = inLeg and legDir == 1 and utDir == 1 and passBuy
flipSell = inLeg and legDir == -1 and utDir == -1 and passSell
if flipBuy or flipSell
    legDone := true

buySig  = obBuy or flipBuy
sellSig = obSell or flipSell

// ══════════════════ 7. TRADE MAP (Entry / SL / TP) ══════════════════
f_targets(_isLong, _entry, _risk) =>
    _all = array.from(pdh, pdl, pwh, pwl, psh, psl, poc, vah, val, equil, trailTop, trailBot)
    _cand = array.new_float()
    if tpLevels
        for _v in _all
            if not na(_v) and (_isLong ? _v > _entry + atrC * 0.2 : _v < _entry - atrC * 0.2)
                array.push(_cand, _v)
        array.sort(_cand, _isLong ? order.ascending : order.descending)
    // Pine v5 evaluates both sides of and/or, so never read the array inside a condition
    _tps = array.new_float()
    float _last = na
    for _v in _cand
        if array.size(_tps) < 3
            if na(_last) or math.abs(_v - _last) > atrC * 0.2
                array.push(_tps, _v)
                _last := _v
    if na(_last)
        _last := _entry
    _step = _isLong ? _risk : -_risk
    while array.size(_tps) < 3
        _last := _last + _step
        array.push(_tps, _last)
    [array.get(_tps, 0), array.get(_tps, 1), array.get(_tps, 2)]

var array<line>  mapLines  = array.new<line>()
var array<label> mapLabels = array.new<label>()

f_mapLevel(_y, _txt, _col, _style) =>
    array.push(mapLines, line.new(bar_index, _y, bar_index + tpBars, _y, color=_col, style=_style, width=1))
    array.push(mapLabels, label.new(bar_index + tpBars, _y, _txt + "  " + str.tostring(_y, format.mintick), style=label.style_label_left, color=color.new(_col, 80), textcolor=_col, size=size.small))

if showTP and (buySig or sellSig)
    for _l in mapLines
        line.delete(_l)
    for _b in mapLabels
        label.delete(_b)
    array.clear(mapLines)
    array.clear(mapLabels)
    isLong = buySig
    entry  = close
    obEdge = isLong ? bullTapBot : bearTapTop
    slOb   = obBuy or obSell ? (isLong ? obEdge - atrC * 0.1 : obEdge + atrC * 0.1) : na
    slUt   = not na(utStop) and (isLong ? utStop < entry : utStop > entry) ? utStop : na
    slAtr  = isLong ? entry - atrC * slAtrMult : entry + atrC * slAtrMult
    sl     = slMode == "Order Block" and not na(slOb) ? slOb : slMode != "ATR" and not na(slUt) ? slUt : slAtr
    risk   = math.max(math.abs(entry - sl), syminfo.mintick)
    [tp1, tp2, tp3] = f_targets(isLong, entry, risk)
    f_mapLevel(entry, "ENTRY", color.gray, line.style_solid)
    f_mapLevel(sl, "SL", color.red, line.style_solid)
    f_mapLevel(tp1, "TP1 " + str.tostring(math.abs(tp1 - entry) / risk, "#.#") + "R", color.lime, line.style_dashed)
    f_mapLevel(tp2, "TP2 " + str.tostring(math.abs(tp2 - entry) / risk, "#.#") + "R", color.green, line.style_dashed)
    f_mapLevel(tp3, "TP3 " + str.tostring(math.abs(tp3 - entry) / risk, "#.#") + "R", color.teal, line.style_dashed)

// ══════════════════ PLOTS ══════════════════
f_brk(_x) => _x != _x[1] ? na : _x

plot(showUtStop ? utStop : na, "UT Trailing Stop", color=utDir == 1 ? color.new(color.green, 0) : color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(showPoc and not newDay ? poc : na, "POC", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(showVA and not newDay ? vah : na, "VAH", color=color.new(color.orange, 40), style=plot.style_linebr)
plot(showVA and not newDay ? val : na, "VAL", color=color.new(color.orange, 40), style=plot.style_linebr)
plot(showPDHL ? f_brk(pdh) : na, "PDH", color=color.new(color.blue, 0), style=plot.style_linebr)
plot(showPDHL ? f_brk(pdl) : na, "PDL", color=color.new(color.blue, 0), style=plot.style_linebr)
plot(showPWHL ? f_brk(pwh) : na, "PWH", color=color.new(color.purple, 0), linewidth=2, style=plot.style_linebr)
plot(showPWHL ? f_brk(pwl) : na, "PWL", color=color.new(color.purple, 0), linewidth=2, style=plot.style_linebr)
plot(showPSHL ? f_brk(psh) : na, "PSH", color=color.new(color.fuchsia, 30), style=plot.style_linebr)
plot(showPSHL ? f_brk(psl) : na, "PSL", color=color.new(color.fuchsia, 30), style=plot.style_linebr)

plotshape(showSig and buySig,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(showSig and sellSig, "SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),   text="SELL", textcolor=color.white, size=size.small)

// Premium / Equilibrium / Discount zones (redrawn on the last bar)
var box zPrem = na
var box zEq   = na
var box zDisc = na
if barstate.islast
    box.delete(zPrem)
    box.delete(zEq)
    box.delete(zDisc)
    if showPDz and not na(trailTop) and not na(trailBot)
        zLeft  = math.max(math.max(trailTopBar, trailBotBar), bar_index - 4999)
        zRight = bar_index + 10
        zPrem := box.new(zLeft, trailTop, zRight, premLine, border_color=color.new(C_PREM, 100), bgcolor=color.new(C_PREM, 80), text="Premium", text_color=C_PREM, text_size=size.small, text_halign=text.align_right, text_valign=text.align_top)
        zEq   := box.new(zLeft, 0.525 * trailTop + 0.475 * trailBot, zRight, 0.525 * trailBot + 0.475 * trailTop, border_color=color.new(C_EQ, 100), bgcolor=color.new(C_EQ, 80), text="Equilibrium", text_color=C_EQ, text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
        zDisc := box.new(zLeft, discLine, zRight, trailBot, border_color=color.new(C_DISC, 100), bgcolor=color.new(C_DISC, 80), text="Discount", text_color=C_DISC, text_size=size.small, text_halign=text.align_right, text_valign=text.align_bottom)

// Level price tags at the right edge
f_tag(_lbl, _show, _y, _txt, _col) =>
    label _l = _lbl
    if _show and showLvlTag and not na(_y)
        _t = _txt + " " + str.tostring(_y, format.mintick)
        if na(_l)
            _l := label.new(bar_index + 2, _y, _t, style=label.style_label_left, color=color.new(_col, 85), textcolor=_col, size=size.small)
        else
            label.set_xy(_l, bar_index + 2, _y)
            label.set_text(_l, _t)
    else if not na(_l)
        label.delete(_l)
        _l := na
    _l

var label tgPDH = na
var label tgPDL = na
var label tgPWH = na
var label tgPWL = na
var label tgPSH = na
var label tgPSL = na
var label tgPOC = na
if barstate.islast
    tgPDH := f_tag(tgPDH, showPDHL, pdh, "PDH", color.blue)
    tgPDL := f_tag(tgPDL, showPDHL, pdl, "PDL", color.blue)
    tgPWH := f_tag(tgPWH, showPWHL, pwh, "PWH", color.purple)
    tgPWL := f_tag(tgPWL, showPWHL, pwl, "PWL", color.purple)
    tgPSH := f_tag(tgPSH, showPSHL, psh, "PSH", color.fuchsia)
    tgPSL := f_tag(tgPSL, showPSHL, psl, "PSL", color.fuchsia)
    tgPOC := f_tag(tgPOC, showPoc, poc, "POC", color.yellow)

// ══════════════════ DASHBOARD ══════════════════
f_dirTxt(_d) => _d == 1 ? "BULL" : _d == -1 ? "BEAR" : "—"
f_dirCol(_d) => _d == 1 ? color.green : _d == -1 ? color.red : color.gray
f_onTxt(_on, _d) => _on ? f_dirTxt(_d) : "OFF"
f_onCol(_on, _d) => _on ? f_dirCol(_d) : color.gray

dashPos = dashPosIn == "Top Left" ? position.top_left : dashPosIn == "Bottom Right" ? position.bottom_right : dashPosIn == "Bottom Left" ? position.bottom_left : position.top_right
var table dash = table.new(dashPos, 2, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 50))
if showDash and barstate.islast
    cvdD   = cvdBull ? 1 : cvdBear ? -1 : 0
    pocD   = na(poc) ? 0 : close > poc ? 1 : close < poc ? -1 : 0
    zoneTx = na(equil) ? "—" : close >= premLine ? "PREMIUM" : close <= discLine ? "DISCOUNT" : close > equil ? "Premium half" : "Discount half"
    zoneCl = na(equil) ? color.gray : close > equil ? C_PREM : C_DISC
    table.cell(dash, 0, 0, "OX ALPHA UT PRO", text_color=color.aqua, text_size=size.small)
    table.cell(dash, 1, 0, "UT " + (useHtf ? utTf : timeframe.period), text_color=color.gray, text_size=size.small)
    table.cell(dash, 0, 1, "Mode", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, obMode ? "OB tap" : "UT flip", text_color=color.aqua, text_size=size.small)
    table.cell(dash, 0, 2, "UT Bot", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, f_dirTxt(utDir), text_color=f_dirCol(utDir), text_size=size.small)
    table.cell(dash, 0, 3, "Structure (" + str.tostring(swingLen) + ")", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, f_onTxt(useStruct, structDir), text_color=f_onCol(useStruct, structDir), text_size=size.small)
    table.cell(dash, 0, 4, "Zone", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, usePD ? zoneTx : "OFF", text_color=usePD ? zoneCl : color.gray, text_size=size.small)
    table.cell(dash, 0, 5, "CVD", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, f_onTxt(useCvd, cvdD), text_color=f_onCol(useCvd, cvdD), text_size=size.small)
    table.cell(dash, 0, 6, "POC side", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, f_onTxt(usePocF, pocD), text_color=f_onCol(usePocF, pocD), text_size=size.small)
    table.cell(dash, 0, 7, "Slow UT", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, f_onTxt(useUt2, ut2Dir), text_color=f_onCol(useUt2, ut2Dir), text_size=size.small)
    table.cell(dash, 0, 8, "Buy filters", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, passBuy ? "PASS ✔" : "WAIT ✘", text_color=passBuy ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 9, "Sell filters", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 9, passSell ? "PASS ✔" : "WAIT ✘", text_color=passSell ? color.red : color.gray, text_size=size.small)
else if not showDash
    table.clear(dash, 0, 0, 1, 9)

// ══════════════════ ALERTS ══════════════════
// Tip: create alerts with "Once Per Bar Close" so signals are final.
alertcondition(buySig,    "BUY signal",          "Ox Alpha UT Pro: BUY {{ticker}} @ {{close}}")
alertcondition(sellSig,   "SELL signal",         "Ox Alpha UT Pro: SELL {{ticker}} @ {{close}}")
alertcondition(bullBreak, "Bullish BOS / CHoCH", "Ox Alpha UT Pro: bullish structure break {{ticker}} @ {{close}}")
alertcondition(bearBreak, "Bearish BOS / CHoCH", "Ox Alpha UT Pro: bearish structure break {{ticker}} @ {{close}}")
alertcondition(utFlipUp,  "UT flip up (raw)",    "Ox Alpha UT Pro: UT flipped bullish {{ticker}} @ {{close}}")
alertcondition(utFlipDn,  "UT flip down (raw)",  "Ox Alpha UT Pro: UT flipped bearish {{ticker}} @ {{close}}")
alertcondition(ta.cross(close, pdh) or ta.cross(close, pdl) or ta.cross(close, pwh) or ta.cross(close, pwl) or ta.cross(close, psh) or ta.cross(close, psl), "Key level cross", "Ox Alpha UT Pro: {{ticker}} crossed a key level (PDH/PDL/PWH/PWL/PSH/PSL) @ {{close}}")
