# Copy this file to .env (same folder) and fill it in. Never commit .env.

# Full path to the MT5 terminal you want to use. Right-click the MT5 shortcut -> Properties -> Target.
# Typical XM install:
MT5_PATH=C:\Program Files\XM Global MT5\terminal64.exe

# Your MT5 account number (not your XM website email).
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
# Exactly as shown in MT5 under File -> Login to Trade Account, e.g. XMGlobal-MT5, XMGlobal-MT5 2, MetaQuotes-Demo
MT5_SERVER=XMGlobal-MT5

# Anything long and random. The web page and every API call must send this.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# Optional safety and tuning
MAGIC=770077          # tags orders placed by this app
DEVIATION=20          # max slippage in points
MAX_LOT=1.0           # the server refuses any order bigger than this
TICK_INTERVAL=0.2     # seconds between websocket price pushes
PORT=8000

# Where the web page updates itself from. Leave it out for the project's own address,
# or set it empty to switch updating off:  UPDATE_URL=

# ----------------------------------------------------------------------------- TradingView alerts
# A URL on the internet that opens real positions is the most dangerous thing in this project, so
# every line below starts in the safe position and has to be changed on purpose.
#
# Off unless this says true.
WEBHOOK_ENABLED=false
# At least 16 characters, and NOT the same as API_KEY: it travels inside the alert message, which
# TradingView stores. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=
# Even with the webhook on, a live account is refused until this says true. Leave it alone while
# you are testing: it is what stops a mistake in a Pine script costing real money.
WEBHOOK_ALLOW_LIVE=false
# The biggest lot an alert may ask for, whatever the alert says. Keep it small.
WEBHOOK_MAX_LOT=0.10
# Used when an alert names no lot.
WEBHOOK_DEFAULT_LOT=0.01
# Only these symbols may be traded by an alert. Empty means any symbol on the account.
WEBHOOK_SYMBOLS=
# More alerts than this in a minute are refused, so a Pine script stuck in a loop cannot machine-gun
# the account.
WEBHOOK_PER_MINUTE=30
