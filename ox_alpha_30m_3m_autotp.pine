//@version=5
indicator("Ox Alpha — 30m Engine + 3m Execution + Auto-TP", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════ INPUTS ══════════════════
htf        = input.timeframe("30",  "Engine Timeframe (UT)")
htfTP      = input.timeframe("30",  "TP Map Timeframe (HTF zones)")
kv1        = input.float(1.0,  "UT1 Factor", step=0.1)
ap1        = input.int(10,     "UT1 ATR Length", minval=1)
kv2        = input.float(3.0,  "UT2 Factor (slow/context)", step=0.1)
ap2        = input.int(30,     "UT2 ATR Length", minval=1)
useLive    = input.bool(true,  "Use LIVE 30m signal for early 3m entry (repaint)")
showTP     = input.bool(true,  "Show TP Map on Signals")
vpBinMult  = input.float(0.5,  "Session Profile Bin Size (× 3m ATR)", minval=0.05, step=0.05)
gateLen    = input.int(3,      "3m Gate Lookback", minval=1)
atr3Len    = input.int(14,     "3m ATR Length")

src = close

// ══════════════════ UT ENGINE (shared function) ══════════════════
f_ut(_src, _kv, _ap) =>
    _nLoss = _kv * ta.atr(_ap)
    var float _stop = na
    _stop := _src > nz(_stop[1]) and _src[1] > nz(_stop[1]) ? math.max(nz(_stop[1]), _src - _nLoss) :
             _src < nz(_stop[1]) and _src[1] < nz(_stop[1]) ? math.min(nz(_stop[1]), _src + _nLoss) :
             _src > nz(_stop[1]) ? _src - _nLoss : _src + _nLoss
    var int _pos = 0
    _pos := _src[1] < nz(_stop[1]) and _src > nz(_stop[1]) ? 1 :
             _src[1] > nz(_stop[1]) and _src < nz(_stop[1]) ? -1 : nz(_pos[1])
    [_stop, _pos, ta.crossover(_src, _stop), ta.crossunder(_src, _stop)]

// Previous-bar values of f_ut (Pine can't apply [1] to a tuple-returning call directly)
f_utPrev(_src, _kv, _ap) =>
    [_s, _p, _b, _sl] = f_ut(_src, _kv, _ap)
    [_s[1], _p[1], _b[1], _sl[1]]

// ---- CONFIRMED 30m (non-repainting, bar-close based) ----
[tStop,  tPos,  tBuy,  tSell ] = request.security(syminfo.tickerid, htf, f_utPrev(src, kv1, ap1), lookahead=barmerge.lookahead_on)
[tStop2, tPos2, tBuy2, tSell2] = request.security(syminfo.tickerid, htf, f_utPrev(src, kv2, ap2), lookahead=barmerge.lookahead_on)

// ---- LIVE 30m (repainting — fires during the forming 30m bar) ----
[lStop, lPos, lBuy, lSell] = request.security(syminfo.tickerid, htf, f_ut(src, kv1, ap1), lookahead=barmerge.lookahead_off)

// ---- Confirmed flips seen from 3m ----
confBuy  = not na(tStop[1]) and close > tStop[1] and close[1] <= tStop[1] and tPos[1] == -1
confSell = not na(tStop[1]) and close < tStop[1] and close[1] >= tStop[1] and tPos[1] ==  1

// ---- LIVE early flips (the "E" signals) ----
liveBuyEarly  = useLive and not na(lStop) and close > lStop and close[1] <= lStop and lPos[1] == -1
liveSellEarly = useLive and not na(lStop) and close < lStop and close[1] >= lStop and lPos[1] ==  1

// Merged signal = early OR confirmed
sigBuy  = liveBuyEarly  or confBuy
sigSell = liveSellEarly or confSell

// ══════════════════ 3m STRUCTURE: BOS / CHoCH ══════════════════
atr3   = ta.atr(atr3Len)
swingL = ta.lowest(low,  gateLen)[1]
swingH = ta.highest(high, gateLen)[1]

var int structTrend = 0
bosUp   = close > swingH and structTrend <= 0
bosDn   = close < swingL and structTrend >= 0
chochUp = close > swingH and structTrend == -1
chochDn = close < swingL and structTrend ==  1
structTrend := bosUp ? 1 : bosDn ? -1 : structTrend

// ══════════════════ 3m POI TRACKERS (FVG + OB) ══════════════════
// Latest unfilled FVGs are kept until price closes through them
var float fvgBullLo = na
var float fvgBullHi = na
var float fvgBearLo = na
var float fvgBearHi = na
// Bullish FVG: low[0] > high[2]
if low > high[2]
    fvgBullLo := high[2]
    fvgBullHi := low
// Bearish FVG: high[0] < low[2]
if high < low[2]
    fvgBearLo := high
    fvgBearHi := low[2]
if not na(fvgBullLo) and close < fvgBullLo
    fvgBullLo := na
    fvgBullHi := na
if not na(fvgBearHi) and close > fvgBearHi
    fvgBearLo := na
    fvgBearHi := na

// Order blocks: last high-volume opposite candle, dropped once price closes through
var float obBullLo = na
var float obBullHi = na
var float obBearLo = na
var float obBearHi = na
volSma     = ta.sma(volume, 20)
bearCandle = close < open and volume > volSma * 1.5
bullCandle = close > open and volume > volSma * 1.5
if bearCandle
    obBearLo := low
    obBearHi := high
if bullCandle
    obBullLo := low
    obBullHi := high
if not na(obBearHi) and close > obBearHi and not bearCandle
    obBearLo := na
    obBearHi := na
if not na(obBullLo) and close < obBullLo and not bullCandle
    obBullLo := na
    obBullHi := na

// Sweep of swing (liquidity grab)
sweepRefL = ta.lowest(low,  gateLen)[2]
sweepRefH = ta.highest(high, gateLen)[2]
sweepLow  = low  < sweepRefL and close > sweepRefL
sweepHigh = high > sweepRefH and close < sweepRefH

// ══════════════════ SESSION VOLUME PROFILE (POC/VAH/VAL) ══════════════════
// Bins are anchored at the session open with a fixed size for the whole session,
// so a bar's volume always lands in the same price bucket.
newSession = timeframe.change("D")
var map<int, float> vpVol = map.new<int, float>()
var float vpAnchor = na
var float vpBin    = na
var int   vpMinK   = na
var int   vpMaxK   = na
var int   vpPocK   = na
var float vpTot    = 0.0
if newSession or na(vpAnchor)
    map.clear(vpVol)
    vpAnchor := open
    vpBin    := math.max(nz(atr3, high - low) * vpBinMult, syminfo.mintick)
    vpMinK   := na
    vpMaxK   := na
    vpPocK   := na
    vpTot    := 0.0

f_vol(_k) =>
    map.contains(vpVol, _k) ? map.get(vpVol, _k) : 0.0

k    = math.floor((close - vpAnchor) / vpBin)
kVol = f_vol(k) + nz(volume)
map.put(vpVol, k, kVol)
vpTot  += nz(volume)
vpMinK := na(vpMinK) ? k : math.min(vpMinK, k)
vpMaxK := na(vpMaxK) ? k : math.max(vpMaxK, k)
float pocVol = -1.0
if not na(vpPocK)
    pocVol := f_vol(vpPocK)
if kVol > pocVol
    vpPocK := k

// Value area: expand from POC toward the heavier neighbour until 70% of volume
loK = vpPocK
hiK = vpPocK
acc = f_vol(vpPocK)
while acc < vpTot * 0.70 and (loK > vpMinK or hiK < vpMaxK)
    loV = loK > vpMinK ? f_vol(loK - 1) : -1.0
    hiV = hiK < vpMaxK ? f_vol(hiK + 1) : -1.0
    if hiV >= loV
        hiK += 1
        acc += hiV
    else
        loK -= 1
        acc += loV

poc = vpAnchor + (vpPocK + 0.5) * vpBin
vah = vpAnchor + (hiK + 1) * vpBin
val = vpAnchor + loK * vpBin

// ══════════════════ POI FILTER + GATE ══════════════════
gateUp = close > swingH
gateDn = close < swingL

nearBullPOI = (not na(fvgBullLo) and low <= fvgBullHi and low >= fvgBullLo - atr3) or
              (not na(obBullLo) and low <= obBullHi + atr3 and low >= obBullLo - atr3) or
              (not na(poc) and math.abs(low - poc) < atr3) or sweepLow
nearBearPOI = (not na(fvgBearLo) and high >= fvgBearLo and high <= fvgBearHi + atr3) or
              (not na(obBearLo) and high >= obBearLo - atr3 and high <= obBearHi + atr3) or
              (not na(poc) and math.abs(high - poc) < atr3) or sweepHigh

buyOK  = sigBuy  and nearBullPOI and gateUp and structTrend ==  1 and (na(tPos2) or tPos2 ==  1)
sellOK = sigSell and nearBearPOI and gateDn and structTrend == -1 and (na(tPos2) or tPos2 == -1)

// ══════════════════ PLOTS ══════════════════
plot(useLive ? lStop : na,  "30m UT LIVE Stop",      color=color.new(color.aqua, 0),  linewidth=2)
plot(tStop,                 "30m UT Confirmed Stop", color=color.new(color.teal, 60), linewidth=1)
plot(tStop2,                "30m UT2 Slow Stop",     color=tPos2 == 1 ? color.new(color.green, 70) : color.new(color.red, 70), linewidth=1)
plot(newSession ? na : poc, "POC", color=color.new(color.yellow, 40), style=plot.style_linebr)
plot(newSession ? na : vah, "VAH", color=color.new(color.red, 70),    style=plot.style_linebr)
plot(newSession ? na : val, "VAL", color=color.new(color.green, 70),  style=plot.style_linebr)

plotshape(buyOK,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text="BOS\nBUY",  textcolor=color.white, size=size.small)
plotshape(sellOK, "SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),   text="BOS\nSELL", textcolor=color.white, size=size.small)
plotshape(chochUp and not buyOK,  "CHoCH Up", shape.triangleup,   location.belowbar, color.new(color.lime, 40),   size=size.tiny, text="CHoCH")
plotshape(chochDn and not sellOK, "CHoCH Dn", shape.triangledown, location.abovebar, color.new(color.maroon, 40), size=size.tiny, text="CHoCH")
plotshape(liveBuyEarly  and not confBuy,  "Early Buy",  shape.circle, location.belowbar, color.new(color.aqua, 0), size=size.tiny, text="E")
plotshape(liveSellEarly and not confSell, "Early Sell", shape.circle, location.abovebar, color.new(color.aqua, 0), size=size.tiny, text="E")

// ══════════════════ AUTO TP PROJECTION (HTF POI-BASED) ══════════════════
// ---- Fetch HTF zones (confirmed, no repaint: previous closed HTF bar) ----
[htfBearOB, htfBearFVG, htfBullOB, htfBullFVG, htfDir] = request.security(syminfo.tickerid, htfTP,
     [obBearLo[1], fvgBearLo[1], obBullHi[1], fvgBullHi[1], structTrend[1]], lookahead=barmerge.lookahead_on)

f_nearAbove(_a, _b, _ref) =>
    _okA = not na(_a) and _a > _ref
    _okB = not na(_b) and _b > _ref
    _okA and _okB ? math.min(_a, _b) : _okA ? _a : _okB ? _b : na

f_nearBelow(_a, _b, _ref) =>
    _okA = not na(_a) and _a < _ref
    _okB = not na(_b) and _b < _ref
    _okA and _okB ? math.max(_a, _b) : _okA ? _a : _okB ? _b : na

// ---- TP1 = nearest opposing 3m zone edge in trade direction ----
tp1Long  = f_nearAbove(fvgBearLo, obBearLo, close)
tp1Short = f_nearBelow(fvgBullHi, obBullHi, close)

// ---- TP2 = nearest opposing HTF zone edge ----
tp2Long  = f_nearAbove(htfBearOB, htfBearFVG, close)
tp2Short = f_nearBelow(htfBullOB, htfBullFVG, close)

// ---- TP3 = session POC (only when it is on the profit side) ----
tp3Long  = not na(poc) and poc > close ? poc : na
tp3Short = not na(poc) and poc < close ? poc : na

var line  tp1L = na
var line  tp2L = na
var line  tp3L = na
var label tp1B = na
var label tp2B = na
var label tp3B = na

if showTP and (buyOK or sellOK)
    line.delete(tp1L)
    line.delete(tp2L)
    line.delete(tp3L)
    label.delete(tp1B)
    label.delete(tp2B)
    label.delete(tp3B)
    isL  = buyOK
    t1   = isL ? tp1Long : tp1Short
    t2   = isL ? tp2Long : tp2Short
    t3   = isL ? tp3Long : tp3Short
    eBar = bar_index + 15
    if not na(t1)
        tp1L := line.new(bar_index, t1, eBar, t1, color=color.new(color.green, 0), style=line.style_dashed, width=1)
        tp1B := label.new(eBar, t1, "TP1 50% → BE", style=label.style_label_left, color=color.new(color.green, 80), textcolor=color.green, size=size.small)
    if not na(t2)
        tp2L := line.new(bar_index, t2, eBar, t2, color=color.new(color.orange, 0), style=line.style_dashed, width=2)
        tp2B := label.new(eBar, t2, "TP2 30% (HTF zone)", style=label.style_label_left, color=color.new(color.orange, 80), textcolor=color.orange, size=size.small)
    if not na(t3)
        tp3L := line.new(bar_index, t3, eBar, t3, color=color.new(color.yellow, 0), style=line.style_dotted, width=2)
        tp3B := label.new(eBar, t3, "TP3 Runner (POC)", style=label.style_label_left, color=color.new(color.yellow, 80), textcolor=color.yellow, size=size.small)

// ══════════════════ HTF ZONE AHEAD WARNING ══════════════════
zoneDist    = atr3 * 0.5
nearHTFzone = (not na(htfBearOB)  and math.abs(close - htfBearOB)  <= zoneDist) or
              (not na(htfBearFVG) and math.abs(close - htfBearFVG) <= zoneDist) or
              (not na(htfBullOB)  and math.abs(close - htfBullOB)  <= zoneDist) or
              (not na(htfBullFVG) and math.abs(close - htfBullFVG) <= zoneDist)
plotshape(nearHTFzone and barstate.isconfirmed, "HTF Zone Ahead", shape.diamond, location.abovebar, color.new(color.yellow, 0), size=size.tiny)
alertcondition(nearHTFzone, "HTF Zone Ahead", "Ox Alpha: price approaching HTF reaction zone — tighten stop / take partial")

// ══════════════════ DASHBOARD (table top-right) ══════════════════
f_dirTxt(_d) => _d == 1 ? "BULL" : _d == -1 ? "BEAR" : "—"
f_dirCol(_d) => _d == 1 ? color.green : _d == -1 ? color.red : color.gray

var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 50))
if barstate.islast
    table.cell(dash, 0, 0, "OX ALPHA",    text_color=color.aqua, text_size=size.small)
    table.cell(dash, 1, 0, "30m/3m",      text_color=color.gray, text_size=size.small)
    table.cell(dash, 0, 1, "3m Trend",    text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, f_dirTxt(structTrend), text_color=f_dirCol(structTrend), text_size=size.small)
    table.cell(dash, 0, 2, "30m Struct",  text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, f_dirTxt(htfDir), text_color=f_dirCol(htfDir), text_size=size.small)
    table.cell(dash, 0, 3, "30m UT1",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, f_dirTxt(tPos),  text_color=f_dirCol(tPos),  text_size=size.small)
    table.cell(dash, 0, 4, "30m UT2",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, f_dirTxt(tPos2), text_color=f_dirCol(tPos2), text_size=size.small)
    table.cell(dash, 0, 5, "POC",         text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, na(poc) ? "—" : str.tostring(poc, format.mintick), text_color=color.yellow, text_size=size.small)
    table.cell(dash, 0, 6, "VAH",         text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, na(vah) ? "—" : str.tostring(vah, format.mintick), text_color=color.red, text_size=size.small)
    table.cell(dash, 0, 7, "VAL",         text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, na(val) ? "—" : str.tostring(val, format.mintick), text_color=color.green, text_size=size.small)
    table.cell(dash, 0, 8, "HTF Zone",    text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, nearHTFzone ? "AHEAD ⚠" : "CLEAR", text_color=nearHTFzone ? color.yellow : color.gray, text_size=size.small)

// ══════════════════ ALERTS ══════════════════
alertcondition(buyOK,         "Buy Signal",     "Ox Alpha: BUY — BOS/CHoCH + POI + Gate + Trend aligned")
alertcondition(sellOK,        "Sell Signal",    "Ox Alpha: SELL — BOS/CHoCH + POI + Gate + Trend aligned")
alertcondition(liveBuyEarly,  "Early Buy (E)",  "Ox Alpha: EARLY BUY — live 30m flip detected")
alertcondition(liveSellEarly, "Early Sell (E)", "Ox Alpha: EARLY SELL — live 30m flip detected")
alertcondition(confBuy,       "Confirmed Buy",  "Ox Alpha: CONFIRMED 30m Buy flip")
alertcondition(confSell,      "Confirmed Sell", "Ox Alpha: CONFIRMED 30m Sell flip")
